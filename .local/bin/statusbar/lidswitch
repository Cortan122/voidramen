#!/bin/sh

set -e

config_path="/etc/systemd/logind.conf"
status="$(awk '/HandleLidSwitch=/' "$config_path" | cut -d'=' -f2)"

toggle() {
  case $status in
    suspend-then-hibernate) sudo sed -i '/HandleLidSwitch=/c HandleLidSwitch=ignore' "$config_path";;
    ignore) sudo sed -i '/HandleLidSwitch=/c HandleLidSwitch=lock' "$config_path";;
    lock) sudo sed -i '/HandleLidSwitch=/c HandleLidSwitch=suspend-then-hibernate' "$config_path";;
  esac

  sudo systemctl kill -s HUP systemd-logind
  status="$(awk '/HandleLidSwitch=/' "$config_path" | cut -d'=' -f2)"
}

ensure_lock_state() {
  if pgrep xss-lock >/dev/null; then
    if [ "$status" != "lock" ]; then
      killall xss-lock
    fi
  elif [ "$status" = "lock" ]; then
    setsid xss-lock -- ~/.local/bin/hotkeys/lock-screen.sh >/dev/null 2>&1 </dev/null &
  fi
}

case $BLOCK_BUTTON in
  1) toggle ;;
  3) notify-send "💤 Lid switch module" "\- Lets you toggle the lid switch action.
- Click to toggle." ;;
esac

ensure_lock_state

case $status in
  suspend-then-hibernate) echo "💤";;
  ignore) echo "🤖";;
  lock) echo "🔐";;
  *) echo "❓";;
esac
